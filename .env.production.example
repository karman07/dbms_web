# Production Environment Variables
# Copy this file to .env.production and fill in your actual values

# ===========================
# Server Configuration
# ===========================
NODE_ENV=production
PORT=3000

# ===========================
# Database - MongoDB
# ===========================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/dbms_production

# OR MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbms_production?retryWrites=true&w=majority

# ===========================
# Authentication - JWT
# ===========================
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_FOR_PRODUCTION
JWT_EXPIRES_IN=7d

# ===========================
# Firebase Admin SDK
# ===========================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ===========================
# Redis Configuration
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_if_set_otherwise_leave_empty

# ===========================
# Cloudinary (Image Upload)
# ===========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===========================
# Email Configuration (Optional)
# ===========================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# ===========================
# CORS Configuration
# ===========================
# Comma-separated list of allowed origins
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# ===========================
# Security
# ===========================
# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ===========================
# Logging
# ===========================
LOG_LEVEL=info
# Options: error, warn, info, debug, verbose

# ===========================
# File Upload Limits
# ===========================
MAX_FILE_SIZE=10485760
# 10MB in bytes (10 * 1024 * 1024)

# ===========================
# Application URLs
# ===========================
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ===========================
# Monitoring (Optional)
# ===========================
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===========================
# Notes:
# ===========================
# 1. Never commit this file to git
# 2. Keep backups in a secure location
# 3. Use strong passwords and secrets
# 4. Update CORS_ORIGIN with your actual domains
# 5. For JWT_SECRET, use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 6. For Redis password: redis-cli> CONFIG SET requirepass "your_password"
