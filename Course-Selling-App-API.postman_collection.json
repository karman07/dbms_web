    {
      "name": "Docs",
      "item": [
        {
          "name": "Admin - Create Topic with Subtopics",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "topic",
                  "value": "DBMS Fundamentals",
                  "type": "text"
                },
                {
                  "key": "course",
                  "value": "dbms",
                  "type": "text"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "sample_docs/01-introduction.md"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "sample_docs/02-er-model.md"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "sample_docs/03-relational-model.md"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "sample_docs/04-sql-basics.md"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/docs/admin/topic",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "admin", "topic"]
            }
          }
        },
        {
          "name": "Admin - Delete Topic",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/docs/admin/topic/{{topicId}}",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "admin", "topic", "{{topicId}}"]
            }
          }
        },
        {
          "name": "Admin - Add Subtopic to Topic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Advanced Topics",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/advanced-topics.md"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/docs/admin/topic/{{topicId}}/subtopic",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "admin", "topic", "{{topicId}}", "subtopic"]
            }
          }
        },
        {
          "name": "Admin - Delete Subtopic",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/docs/admin/topic/{{topicId}}/subtopic/{{subtopicName}}",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "admin", "topic", "{{topicId}}", "subtopic", "{{subtopicName}}"]
            }
          }
        },
        {
          "name": "Get All Topics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/topics",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "topics"]
            }
          }
        },
        {
          "name": "Get Topic Subtopics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/topic/{{topicId}}",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "topic", "{{topicId}}"]
            }
          }
        },
        {
          "name": "Get Subtopic Content",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/topic/{{topicId}}/subtopic/{{subtopicName}}",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "topic", "{{topicId}}", "subtopic", "{{subtopicName}}"]
            }
          }
        },
        {
          "name": "Download Subtopic as MD File",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/topic/{{topicId}}/subtopic/{{subtopicName}}/download",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "topic", "{{topicId}}", "subtopic", "{{subtopicName}}", "download"]
            }
          }
